# Replit configuration for EgySafe (Vite + React + Express)
# The dev server (server.ts) runs via tsx and serves the Vite app through
# Express middleware in development, and the prebuilt dist/ in production.

run = "npm run dev"
entrypoint = "server.ts"
modules = ["nodejs-20"]

hidden = [".config", "dist", "node_modules", ".vault.json"]

[nix]
channel = "stable-24_05"

[env]
# The Express server reads process.env.PORT and binds to 0.0.0.0.
# Replit injects PORT automatically; 3000 is the local fallback.
NODE_ENV = "development"

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json"]

# Map the app's internal port to the public Replit URL.
[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 3000

# Deployment: build the static bundle, then run the server in production mode
# so Express serves the optimized dist/ output instead of the Vite dev server.
[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "NODE_ENV=production npm run dev"]

[workflows]
runButton = "Dev Server"

[[workflows.workflow]]
name = "Dev Server"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
